#!/bin/sh
# Launcher for the bundled IraLens native browser engine.
#
# This file is package data: it is intentionally relocatable and contains
# no absolute paths. Do not regenerate it at runtime; the per-user,
# machine-local launcher is written to the writable engine cache instead
# (see ensure_generated_launcher).
set -eu
if [ -n "${IRALENS_PYTHON:-}" ] && [ -x "${IRALENS_PYTHON}" ]; then
  exec "${IRALENS_PYTHON}" -m iralens._internal.browser_engine.mcp_server "$@"
fi
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" -m iralens._internal.browser_engine.mcp_server "$@"
  fi
done
echo "iralens-browser-engine: no python interpreter found" >&2
exit 127
